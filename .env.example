# ========== SearXNG 代理配置 ==========
# 复制此文件为 .env 后修改，重启生效: docker compose restart searxng
#
# 格式: 地址:端口（不带协议前缀）
# 如果代理在本机（如 Clash），地址用 host.docker.internal
#
# 示例:
#   局域网代理:  PROXY_SOCKS5=192.168.1.1:1080
#   本机 Clash:  PROXY_SOCKS5=host.docker.internal:7890
#   不使用代理:  注释掉或留空

PROXY_SOCKS5=
PROXY_HTTP=
